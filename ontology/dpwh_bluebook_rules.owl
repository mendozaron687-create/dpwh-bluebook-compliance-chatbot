<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.example.org/dpwh-bluebook-rules"
         xmlns="http://www.example.org/dpwh-bluebook-rules#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#">

<owl:Ontology rdf:about="http://www.example.org/dpwh-bluebook-rules">
  <owl:imports rdf:resource="http://www.example.org/dpwh-bluebook"/>
</owl:Ontology>

<owl:NamedIndividual rdf:about="#BelowMinimum">
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="http://www.example.org/dpwh-bluebook#TestResult"/>
          <swrl:argument1 rdf:resource="urn:swrl#r"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="http://www.example.org/dpwh-bluebook#evaluatesLimit"/>
              <swrl:argument1 rdf:resource="urn:swrl#r"/>
              <swrl:argument2 rdf:resource="urn:swrl#l"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:DatavaluedPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="http://www.example.org/dpwh-bluebook#measuredValue"/>
                  <swrl:argument1 rdf:resource="urn:swrl#r"/>
                  <swrl:argument2 rdf:resource="urn:swrl#v"/>
                </swrl:DatavaluedPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:DatavaluedPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="http://www.example.org/dpwh-bluebook#hasMinimumValue"/>
                      <swrl:argument1 rdf:resource="urn:swrl#l"/>
                      <swrl:argument2 rdf:resource="urn:swrl#m"/>
                    </swrl:DatavaluedPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <swrl:IndividualPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="http://www.example.org/dpwh-bluebook#hasUnit"/>
                          <swrl:argument1 rdf:resource="urn:swrl#r"/>
                          <swrl:argument2 rdf:resource="urn:swrl#u"/>
                        </swrl:IndividualPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:first>
                            <swrl:IndividualPropertyAtom>
                              <swrl:propertyPredicate rdf:resource="http://www.example.org/dpwh-bluebook#hasUnit"/>
                              <swrl:argument1 rdf:resource="urn:swrl#l"/>
                              <swrl:argument2 rdf:resource="urn:swrl#u"/>
                            </swrl:IndividualPropertyAtom>
                          </rdf:first>
                          <rdf:rest>
                            <rdf:Description>
                              <rdf:first>
                                <swrl:BuiltinAtom>
                                  <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThan"/>
                                  <swrl:arguments>
                                    <rdf:Description>
                                      <rdf:first rdf:resource="urn:swrl#v"/>
                                      <rdf:rest>
                                        <rdf:Description>
                                          <rdf:first rdf:resource="urn:swrl#m"/>
                                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                        </rdf:Description>
                                      </rdf:rest>
                                    </rdf:Description>
                                  </swrl:arguments>
                                </swrl:BuiltinAtom>
                              </rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                          </rdf:rest>
                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="http://www.example.org/dpwh-bluebook#hasComplianceOutcome"/>
          <swrl:argument1 rdf:resource="urn:swrl#r"/>
          <swrl:argument2 rdf:resource="http://www.example.org/dpwh-bluebook#NonCompliant"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Not Blue Book content: generic comparison of a result against a stated bound. Compliant is not inferred (open-world); it is decided at retrieval time.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#AboveMaximum">
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="http://www.example.org/dpwh-bluebook#TestResult"/>
          <swrl:argument1 rdf:resource="urn:swrl#r"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="http://www.example.org/dpwh-bluebook#evaluatesLimit"/>
              <swrl:argument1 rdf:resource="urn:swrl#r"/>
              <swrl:argument2 rdf:resource="urn:swrl#l"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:DatavaluedPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="http://www.example.org/dpwh-bluebook#measuredValue"/>
                  <swrl:argument1 rdf:resource="urn:swrl#r"/>
                  <swrl:argument2 rdf:resource="urn:swrl#v"/>
                </swrl:DatavaluedPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:DatavaluedPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="http://www.example.org/dpwh-bluebook#hasMaximumValue"/>
                      <swrl:argument1 rdf:resource="urn:swrl#l"/>
                      <swrl:argument2 rdf:resource="urn:swrl#x"/>
                    </swrl:DatavaluedPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <swrl:IndividualPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="http://www.example.org/dpwh-bluebook#hasUnit"/>
                          <swrl:argument1 rdf:resource="urn:swrl#r"/>
                          <swrl:argument2 rdf:resource="urn:swrl#u"/>
                        </swrl:IndividualPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:first>
                            <swrl:IndividualPropertyAtom>
                              <swrl:propertyPredicate rdf:resource="http://www.example.org/dpwh-bluebook#hasUnit"/>
                              <swrl:argument1 rdf:resource="urn:swrl#l"/>
                              <swrl:argument2 rdf:resource="urn:swrl#u"/>
                            </swrl:IndividualPropertyAtom>
                          </rdf:first>
                          <rdf:rest>
                            <rdf:Description>
                              <rdf:first>
                                <swrl:BuiltinAtom>
                                  <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThan"/>
                                  <swrl:arguments>
                                    <rdf:Description>
                                      <rdf:first rdf:resource="urn:swrl#v"/>
                                      <rdf:rest>
                                        <rdf:Description>
                                          <rdf:first rdf:resource="urn:swrl#x"/>
                                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                        </rdf:Description>
                                      </rdf:rest>
                                    </rdf:Description>
                                  </swrl:arguments>
                                </swrl:BuiltinAtom>
                              </rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                          </rdf:rest>
                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="http://www.example.org/dpwh-bluebook#hasComplianceOutcome"/>
          <swrl:argument1 rdf:resource="urn:swrl#r"/>
          <swrl:argument2 rdf:resource="http://www.example.org/dpwh-bluebook#NonCompliant"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Not Blue Book content: generic comparison of a result against a stated bound. Compliant is not inferred (open-world); it is decided at retrieval time.</rdfs:comment>
</owl:NamedIndividual>

<swrl:Variable rdf:about="urn:swrl#r"/>

<swrl:Variable rdf:about="urn:swrl#l"/>

<swrl:Variable rdf:about="urn:swrl#v"/>

<swrl:Variable rdf:about="urn:swrl#m"/>

<swrl:Variable rdf:about="urn:swrl#u"/>

<swrl:Variable rdf:about="urn:swrl#x"/>


</rdf:RDF>
