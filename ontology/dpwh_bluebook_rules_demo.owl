<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.example.org/dpwh-bluebook-rules-demo#"
     xml:base="http://www.example.org/dpwh-bluebook-rules-demo"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:dpwh="http://www.example.org/dpwh-bluebook#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="http://www.example.org/dpwh-bluebook-rules-demo">
        <owl:imports rdf:resource="http://www.example.org/dpwh-bluebook"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.example.org/dpwh-bluebook#appliesToMaterial -->

    <rdf:Description rdf:about="http://www.example.org/dpwh-bluebook#appliesToMaterial">
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/dpwh-bluebook#Material"/>
                    <rdf:Description rdf:about="http://www.example.org/dpwh-bluebook#TestMethod"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </rdf:Description>
    


    <!-- http://www.example.org/dpwh-bluebook#appliesToWork -->

    <rdf:Description rdf:about="http://www.example.org/dpwh-bluebook#appliesToWork">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/dpwh-bluebook#ApplicabilityCondition"/>
                    <rdf:Description rdf:about="http://www.example.org/dpwh-bluebook#Requirement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/dpwh-bluebook#BlueBookItem"/>
                    <rdf:Description rdf:about="http://www.example.org/dpwh-bluebook#Requirement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/dpwh-bluebook#ConstructionWork"/>
                    <rdf:Description rdf:about="http://www.example.org/dpwh-bluebook#Requirement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/dpwh-bluebook#QuantitativeLimit"/>
                    <rdf:Description rdf:about="http://www.example.org/dpwh-bluebook#Requirement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/dpwh-bluebook#Requirement"/>
                    <rdf:Description rdf:about="http://www.example.org/dpwh-bluebook#TestMethod"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/dpwh-bluebook#ConstructionWork"/>
                    <rdf:Description rdf:about="http://www.example.org/dpwh-bluebook#Requirement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </rdf:Description>
    


    <!-- http://www.example.org/dpwh-bluebook#belongsToVolume -->

    <rdf:Description rdf:about="http://www.example.org/dpwh-bluebook#belongsToVolume">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/dpwh-bluebook#BlueBookItem"/>
                    <rdf:Description rdf:about="http://www.example.org/dpwh-bluebook#Requirement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/dpwh-bluebook#belongsToVolume"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/dpwh-bluebook#Volume"/>
            </owl:Restriction>
        </rdfs:domain>
    </rdf:Description>
    


