  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ConcreteMaterial</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Preliminary category.</rdfs:comment>
</owl:Class>

