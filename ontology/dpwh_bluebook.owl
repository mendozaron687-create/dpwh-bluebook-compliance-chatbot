  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BituminousMaterial</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Preliminary category.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SteelMaterial">
  <rdfs:subClassOf rdf:resource="#Material"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SteelMaterial</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Preliminary category.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TimberMaterial">
  <rdfs:subClassOf rdf:resource="#Material"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TimberMaterial</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Preliminary category.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MasonryMaterial">
  <rdfs:subClassOf rdf:resource="#Material"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MasonryMaterial</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Preliminary category.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PipeAndDrainageMaterial">
  <rdfs:subClassOf rdf:resource="#Material"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PipeAndDrainageMaterial</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Preliminary category.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PaintAndCoatingMaterial">
  <rdfs:subClassOf rdf:resource="#Material"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PaintAndCoatingMaterial</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Preliminary category.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#GeosyntheticMaterial">
  <rdfs:subClassOf rdf:resource="#Material"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GeosyntheticMaterial</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Preliminary category.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Admixture">
  <rdfs:subClassOf rdf:resource="#Material"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Admixture</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Preliminary category.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TestMethod">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TestMethod</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sampling or testing procedure (e.g. an AASHTO or ASTM method) cited by the Blue Book.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ReferenceStandard">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ReferenceStandard</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An external standard referenced by the Blue Book (AASHTO, ASTM, PNS, etc.).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#QualityParameter">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QualityParameter</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measurable property that is specified or tested (e.g. compressive strength, slump).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MeasurementUnit">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MeasurementUnit</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A unit of measurement. Kept separate from numeric values.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#QualityControlActivity">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QualityControlActivity</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A QA/QC activity required by the specifications.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SamplingActivity">
  <rdfs:subClassOf rdf:resource="#QualityControlActivity"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SamplingActivity</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#InspectionActivity">
  <rdfs:subClassOf rdf:resource="#QualityControlActivity"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InspectionActivity</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#TestingActivity">
  <rdfs:subClassOf rdf:resource="#QualityControlActivity"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TestingActivity</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SubmittalActivity">
  <rdfs:subClassOf rdf:resource="#QualityControlActivity"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SubmittalActivity</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Submission of certificates, test reports, or samples.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Requirement">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Requirement</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A normative statement from the Blue Book.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MaterialRequirement">
  <rdfs:subClassOf rdf:resource="#Requirement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MaterialRequirement</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#WorkmanshipRequirement">
  <rdfs:subClassOf rdf:resource="#Requirement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WorkmanshipRequirement</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#TestingRequirement">
  <rdfs:subClassOf rdf:resource="#Requirement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TestingRequirement</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#QualityControlRequirement">
  <rdfs:subClassOf rdf:resource="#Requirement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QualityControlRequirement</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#QualityAssuranceRequirement">
  <rdfs:subClassOf rdf:resource="#Requirement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QualityAssuranceRequirement</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#QuantitativeLimit">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QuantitativeLimit</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A numeric bound or exact value attached to a quality parameter.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AcceptanceCriterion">
  <rdfs:subClassOf rdf:resource="#QuantitativeLimit"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AcceptanceCriterion</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A limit that a test result must satisfy for acceptance.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ToleranceValue">
  <rdfs:subClassOf rdf:resource="#QuantitativeLimit"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ToleranceValue</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An allowable deviation or tolerance.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SpecificationLimit">
  <rdfs:subClassOf rdf:resource="#QuantitativeLimit"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SpecificationLimit</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A limit on a material or work property that is not an acceptance test (e.g. gradation band, thickness).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TestingFrequency">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TestingFrequency</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">How often sampling or testing is required (e.g. 1 test per 150 cu.m).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ApplicabilityCondition">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ApplicabilityCondition</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A condition under which a requirement applies (class, grade, location, work type).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TestResult">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TestResult</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A submitted or measured result to be checked against a limit. Not Blue Book content.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ComplianceOutcome">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ComplianceOutcome</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Verdict category assigned to a test result.</rdfs:comment>
</owl:Class>

